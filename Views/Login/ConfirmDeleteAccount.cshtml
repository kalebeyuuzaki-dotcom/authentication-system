@model Portifolio.Models.ViewModels.DeleteAccountViewModel

@{
    ViewData["Title"] = "Confirmar exclusão da conta";
}

<div class="container my-5" style="max-width: 650px;">
    <div class="card border-danger shadow-sm">
        <div class="card-body p-4">
            <h1 class="h3 text-danger mb-3">Excluir minha conta</h1>
            <p class="text-secondary">
                Esta ação é permanente e não poderá ser desfeita. Para confirmar,
                informe sua senha atual.
            </p>

            @if (ViewBag.ErrorMessage is string errorMessage)
            {
                <div class="alert alert-danger" role="alert">@errorMessage</div>
            }

            <form asp-controller="Login" asp-action="DeleteAccount" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-4">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-danger">Confirmar exclusão</button>
                    <a asp-controller="Login" asp-action="Panel" class="btn btn-outline-secondary">
                        Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
